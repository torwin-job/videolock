#!/usr/bin/env python3
"""videolock launcher — resolves package from repo or user install."""
from __future__ import annotations

import os
import sys
from pathlib import Path


def _candidates() -> list[Path]:
    here = Path(__file__).resolve()
    out: list[Path] = []
    env = os.environ.get("VIDEOLOCK_PYTHONPATH", "").strip()
    if env:
        out.append(Path(env).expanduser())
    # Repo checkout: <root>/bin/videolock → <root>/videolock/
    out.append(here.parent.parent)
    # User install: ~/.local/share/videolock/python/videolock/
    xdg = os.environ.get("XDG_DATA_HOME", str(Path.home() / ".local/share"))
    out.append(Path(xdg) / "videolock" / "python")
    # PREFIX install sibling: ~/.local/lib/videolock/… (optional)
    out.append(Path.home() / ".local" / "lib")
    return out


def _bootstrap() -> None:
    for root in _candidates():
        pkg = root / "videolock"
        if pkg.is_dir() and (pkg / "__init__.py").is_file():
            p = str(root)
            if p not in sys.path:
                sys.path.insert(0, p)
            return
    sys.stderr.write(
        "videolock: Python package not found. Re-run ./install.sh "
        "or set VIDEOLOCK_PYTHONPATH to the directory that contains videolock/.\n"
    )
    raise SystemExit(1)


_bootstrap()
from videolock.cli import run  # noqa: E402

if __name__ == "__main__":
    run()

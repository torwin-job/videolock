#!/usr/bin/env python3
"""videolock — Hyprland / Wayland session lock (GTK4 + Gtk4SessionLock + PAM)."""
from __future__ import annotations

import argparse
import fcntl
import json
import locale
import os
import pwd
import signal
import subprocess
import sys
import time
import traceback
from datetime import datetime
from pathlib import Path

__version__ = "0.2.3"

os.environ.setdefault("GTK_IM_MODULE", "none")
os.environ.setdefault("GST_PLUGIN_FEATURE_RANK", "vah264dec:MAX,vaapih264dec:MAX")

from ctypes import CDLL

for lib in ("libgtk4-layer-shell.so", "libgtk-session-lock.so"):
    try:
        CDLL(lib)
    except OSError:
        pass

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gtk4SessionLock", "1.0")

from gi.repository import Gdk, GLib, Gio, Gtk, Gtk4SessionLock as SessionLock

try:
    import pam
except ImportError:
    pam = None


# --- paths (XDG + env overrides) -------------------------------------------------

def _xdg_home(env_key: str, default_under_home: str) -> Path:
    raw = os.environ.get(env_key)
    if raw:
        return Path(raw).expanduser()
    return Path.home() / default_under_home


CACHE_DIR = _xdg_home("XDG_CACHE_HOME", ".cache") / "videolock"
DATA_DIR = _xdg_home("XDG_DATA_HOME", ".local/share") / "videolock"
CONFIG_DIR = _xdg_home("XDG_CONFIG_HOME", ".config") / "videolock"

for _d in (CACHE_DIR, DATA_DIR):
    try:
        _d.mkdir(parents=True, exist_ok=True)
        os.chmod(_d, 0o700)
    except OSError:
        pass

LOG = CACHE_DIR / "videolock.log"
LOCKFILE = CACHE_DIR / "videolock.lock"

# Asset resolution order: env → data dir → legacy ~/Videos/wallpapers (compat)
def _resolve_asset(env_name: str, *candidates: Path) -> Path:
    env = os.environ.get(env_name)
    if env:
        return Path(env).expanduser()
    for c in candidates:
        if c.is_file() or (env_name.endswith("FRAMES") and c.is_dir()):
            return c
    return candidates[0]


POSTER = _resolve_asset(
    "VIDEOLOCK_POSTER",
    DATA_DIR / "poster.png",
    DATA_DIR / "poster.jpg",
    Path.home() / "Videos/wallpapers/login-lock.png",
)
VIDEO = _resolve_asset(
    "VIDEOLOCK_VIDEO",
    DATA_DIR / "video.mp4",
    Path.home() / "Videos/wallpapers/login-lock.mp4",
)
FRAME_DIR = _resolve_asset(
    "VIDEOLOCK_FRAMES",
    DATA_DIR / "frames",
    Path.home() / "Videos/wallpapers/login-frames",
)

_lock_fd = None

# --- i18n -----------------------------------------------------------------------

_STRINGS = {
    "en": {
        "hint": "type password · Enter to unlock",
        "bad_password": "wrong password",
        "wait": "wait {n} s",
        "pam_missing": "python-pam missing — lock cancelled",
        "caps": "CAPS",
    },
    "ru": {
        "hint": "ввод пароля · Enter — войти",
        "bad_password": "неверный пароль",
        "wait": "подождите {n} с",
        "pam_missing": "Нет модуля pam — блокировка отменена",
        "caps": "CAPS",
    },
}


def _ui_lang() -> str:
    forced = os.environ.get("VIDEOLOCK_LANG", "").lower().strip()
    if forced in _STRINGS:
        return forced
    try:
        loc = locale.getlocale()[0] or ""
    except Exception:
        loc = ""
    if loc.lower().startswith("ru"):
        return "ru"
    return "en"


def _(key: str, **kwargs) -> str:
    lang = _ui_lang()
    text = _STRINGS.get(lang, _STRINGS["en"]).get(key) or _STRINGS["en"][key]
    return text.format(**kwargs) if kwargs else text


# --- helpers --------------------------------------------------------------------

def _pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False


def _read_lock_pid() -> int | None:
    try:
        raw = LOCKFILE.read_text().strip()
        return int(raw) if raw else None
    except Exception:
        return None


def _clear_stale_lockfile() -> bool:
    """Remove lockfile if owner PID is dead. Returns True if cleared/absent."""
    pid = _read_lock_pid()
    if pid is not None and _pid_alive(pid):
        return False
    try:
        if LOCKFILE.exists():
            LOCKFILE.unlink()
            if pid is not None:
                log(f"cleared stale lockfile (dead pid {pid})")
        return True
    except OSError:
        return False


def _recover_session() -> int:
    """Stop hung locker + clear Hyprland crash-lock overlay."""
    print(f"videolock {__version__} — recover")
    pid = _read_lock_pid()
    if pid is not None and _pid_alive(pid):
        print(f"  signaling locker pid={pid} (SIGTERM)")
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError as e:
            print(f"  SIGTERM failed: {e}")
        for _ in range(10):
            if not _pid_alive(pid):
                break
            time.sleep(0.1)
        if _pid_alive(pid):
            print(f"  SIGKILL pid={pid}")
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
    elif pid is not None:
        print(f"  stale lockfile pid={pid} (not running)")
    else:
        print("  no live locker pid in lockfile")

    _clear_stale_lockfile()
    try:
        if LOCKFILE.exists():
            LOCKFILE.unlink()
    except OSError:
        pass

    out = _hyprctl(["eval", "hl.clear_crashed_lockscreen()"])
    if out:
        print(f"  clear_crashed_lockscreen: {out}")
    else:
        _hyprctl(["dispatch", "forcerendererreload"])
        print("  attempted forcerendererreload (HyDE clear may be unavailable)")
    print("  recover done")
    return 0


def _acquire_singleton() -> bool:
    """Flock singleton; clears stale PID lockfiles once."""
    global _lock_fd
    for attempt in range(2):
        try:
            _lock_fd = open(LOCKFILE, "w")
            fcntl.flock(_lock_fd.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            _lock_fd.seek(0)
            _lock_fd.truncate()
            _lock_fd.write(str(os.getpid()))
            _lock_fd.flush()
            try:
                os.chmod(LOCKFILE, 0o600)
            except OSError:
                pass
            return True
        except OSError:
            try:
                if _lock_fd is not None:
                    _lock_fd.close()
            except Exception:
                pass
            _lock_fd = None
            if attempt == 0 and _clear_stale_lockfile():
                continue
            return False
    return False


def log(msg: str) -> None:
    line = f"{datetime.now().strftime('%H:%M:%S.%f')[:-3]} {msg}"
    try:
        fd = os.open(str(LOG), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(fd, "a") as f:
            f.write(line + "\n")
    except Exception:
        pass


def _wipe_bytearray(buf: bytearray) -> None:
    for i in range(len(buf)):
        buf[i] = 0
    buf.clear()


def _hyprctl(args: list[str], timeout: float = 1.5) -> str:
    try:
        r = subprocess.run(
            ["hyprctl", *args],
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
        if r.returncode != 0:
            return ""
        return (r.stdout or "").strip()
    except Exception:
        return ""


def _reset_keyboard_layout() -> None:
    """Force primary layout (usually us) so password entry is not stuck on RU."""
    if os.environ.get("VIDEOLOCK_RESET_LAYOUT", "1") != "1":
        return
    out = _hyprctl(["switchxkblayout", "all", "0"])
    log(f"reset layout → primary (all 0) {out!r}")


def _active_keymap_raw() -> str:
    raw = _hyprctl(["devices", "-j"])
    if not raw:
        return ""
    try:
        data = json.loads(raw)
    except json.JSONDecodeError:
        return ""
    keyboards = data.get("keyboards") or []
    main = next((k for k in keyboards if k.get("main")), None)
    kb = main or (keyboards[0] if keyboards else None)
    if not kb:
        return ""
    return str(kb.get("active_keymap") or kb.get("layout") or "")


def _short_layout(keymap: str) -> str:
    n = (keymap or "").lower()
    if not n:
        return "?"
    if "russian" in n or n.startswith("ru") or ",ru" in n or n == "ru":
        return "RU"
    if "english" in n or "us" in n or n.startswith("en"):
        return "US"
    if "german" in n or n.startswith("de"):
        return "DE"
    if "french" in n or n.startswith("fr"):
        return "FR"
    if "ukrain" in n or n.startswith("ua") or n.startswith("uk"):
        return "UA"
    # fallback: first token / layout code
    token = keymap.split(",")[0].strip()
    if "(" in token:
        token = token.split("(")[0].strip()
    return (token[:3] or "?").upper()


def _caps_lock_on(fallback: bool = False) -> bool:
    try:
        display = Gdk.Display.get_default()
        if display is None:
            return fallback
        seat = display.get_default_seat()
        if seat is None:
            return fallback
        kb = seat.get_keyboard()
        if kb is not None and hasattr(kb, "get_caps_lock_state"):
            return bool(kb.get_caps_lock_state())
    except Exception:
        pass
    return fallback


def _font_stack() -> str:
    # Default: Pixelon — same pixel font as SDDM Astronaut (hyde_unified / hyprland_kath)
    custom = os.environ.get("VIDEOLOCK_FONT", "").strip()
    if custom:
        return f'"{custom}", "Pixelon", monospace'
    return '"Pixelon", "pixelon", "ArcadeClassic", monospace'


def _ui_scale() -> float:
    """Logical UI scale for HiDPI / Hyprland fractional scale (0.7–2.5)."""
    env = os.environ.get("VIDEOLOCK_SCALE", "").strip()
    if env:
        try:
            return max(0.7, min(2.5, float(env)))
        except ValueError:
            pass
    # Prefer Hyprland monitor scale (supports 1.2 etc.)
    raw = _hyprctl(["monitors", "-j"])
    base = 1.0
    if raw:
        try:
            mons = json.loads(raw)
            scales = [float(m.get("scale") or 1.0) for m in mons if m]
            if scales:
                base = max(scales)
        except Exception:
            pass
    else:
        try:
            display = Gdk.Display.get_default()
            if display is not None:
                mon = display.get_monitors().get_item(0)
                if mon is not None and hasattr(mon, "get_scale_factor"):
                    base = float(mon.get_scale_factor())
        except Exception:
            pass
    # Slightly denser than 1:1 so panel doesn't dominate (Pixelon reads large)
    density = 0.88
    dens_env = os.environ.get("VIDEOLOCK_DENSITY", "").strip()
    if dens_env:
        try:
            density = max(0.7, min(1.2, float(dens_env)))
        except ValueError:
            pass
    return max(0.7, min(2.5, base * density))


def _px(n: float, scale: float) -> str:
    return f"{max(1, int(round(n * scale)))}px"


def _build_css(scale: float | None = None) -> bytes:
    s = scale if scale is not None else _ui_scale()
    font = _font_stack()
    # Base sizes tuned smaller for Pixelon (bitmap fonts look oversized at JetBrains sizes)
    return f"""
window {{ background: #0b1020; }}
.dim {{ background: rgba(8,12,24,0.22); }}
.panel {{
  background: rgba(17,22,40,0.62);
  border: 1px solid rgba(120,160,255,0.35);
  border-radius: {_px(16, s)};
  padding: {_px(20, s)} {_px(26, s)};
}}
.clock {{ color: #e8eeff; font-size: {_px(56, s)}; font-weight: 400; font-family: {font}; }}
.date {{ color: #b8c4e0; font-size: {_px(14, s)}; margin-bottom: {_px(10, s)}; font-family: {font}; }}
.user {{ color: #89b4fa; font-size: {_px(13, s)}; margin-bottom: {_px(10, s)}; font-family: {font}; }}
.dots {{
  color: #e8eeff; font-size: {_px(22, s)}; letter-spacing: {_px(5, s)};
  min-width: {_px(260, s)}; min-height: {_px(40, s)}; padding: {_px(8, s)} {_px(12, s)};
  border-radius: {_px(10, s)}; background: rgba(12,16,28,0.92);
  border: 1px solid rgba(120,160,255,0.55);
  font-family: {font};
}}
.error {{ color: #f38ba8; font-size: {_px(12, s)}; min-height: {_px(16, s)}; margin-top: {_px(6, s)}; font-family: {font}; }}
.hint {{ color: #7f8aad; font-size: {_px(11, s)}; margin-top: {_px(8, s)}; font-family: {font}; }}
.status {{
  color: #a6adc8; font-size: {_px(11, s)}; margin-top: {_px(8, s)}; letter-spacing: {_px(2, s)};
  font-family: {font};
}}
.status-warn {{ color: #f9e2af; }}
.status-caps {{ color: #fab387; }}
""".encode()


# --- locker ---------------------------------------------------------------------

class VideoLock:
    def __init__(self, app: Gtk.Application):
        self.app = app
        self.user = pwd.getpwuid(os.getuid()).pw_name
        self._pw = bytearray()
        self._fail_count = 0
        self._unlock_blocked_until = 0.0
        self._clock_pairs: list[tuple[Gtk.Label, Gtk.Label]] = []
        self._dot_labels: list[Gtk.Label] = []
        self._err_labels: list[Gtk.Label] = []
        self._monitors_done: set[str] = set()
        self._windows: list[Gtk.Window] = []
        self._bg_stack: list[Gtk.Stack] = []
        self._media = None
        self._frame_textures: list = []
        self._frame_i = 0
        self._using_frames = False
        self._shutting_down = False
        self._status_labels: list[Gtk.Label] = []
        self._layout_code = "?"
        self._caps = False

        self.lock = SessionLock.Instance.new()
        self.lock.connect("locked", lambda *_: log("locked"))
        self.lock.connect("unlocked", self._on_unlocked)
        self.lock.connect("failed", self._on_failed)
        self.lock.connect("monitor", self._on_monitor)

        signal.signal(signal.SIGTERM, self._on_signal)
        signal.signal(signal.SIGINT, self._on_signal)

    def _on_signal(self, signum, _frame):
        log(f"signal {signum} — graceful unlock")
        GLib.idle_add(self._graceful_unlock)

    def _graceful_unlock(self):
        if self._shutting_down:
            return False
        try:
            if self.lock.is_locked():
                self.lock.unlock()
            else:
                self._shutdown()
        except Exception as e:
            log(f"graceful unlock: {e}")
            self._shutdown()
        return False

    def _on_unlocked(self, *_):
        log("unlocked")
        self._shutdown()

    def _on_failed(self, *_):
        log("failed")
        self._shutdown()

    def _shutdown(self):
        if self._shutting_down:
            return
        self._shutting_down = True
        self._wipe_password()
        if self._media is not None:
            try:
                self._media.pause()
            except Exception:
                pass
            self._media = None
        try:
            self.app.release()
        except Exception:
            pass
        self.app.quit()

    def start(self) -> None:
        if pam is None:
            log("FATAL: python pam module missing — refusing to lock")
            try:
                from subprocess import Popen
                Popen(
                    ["notify-send", "-u", "critical", "videolock", _("pam_missing")],
                    start_new_session=True,
                )
            except Exception:
                pass
            self.app.quit()
            return
        if not SessionLock.is_supported():
            log("unsupported: ext-session-lock-v1")
            self._shutdown()
            return
        self.app.hold()
        # Critical: unlock passwords are almost always ASCII — reset to primary layout
        _reset_keyboard_layout()
        self._layout_code = _short_layout(_active_keymap_raw())
        self._caps = _caps_lock_on(False)
        self._refresh_status_labels()
        log(
            f"lock() video={VIDEO} frames={FRAME_DIR} poster={POSTER} "
            f"gst={os.environ.get('VIDEOLOCK_GST', '0')} layout={self._layout_code}"
        )
        ok = self.lock.lock()
        log(f"lock -> {ok!r} locked={self.lock.is_locked()}")
        if not ok and not self.lock.is_locked():
            GLib.timeout_add(200, self._retry_lock, 1)
        GLib.timeout_add_seconds(1, self._tick_clock)
        GLib.timeout_add(400, self._tick_status)

    def _retry_lock(self, attempt: int):
        if self.lock.is_locked():
            return False
        ok = self.lock.lock()
        if ok or self.lock.is_locked():
            return False
        if attempt >= 5:
            self._shutdown()
            return False
        GLib.timeout_add(200, self._retry_lock, attempt + 1)
        return False

    def _tick_clock(self):
        now = datetime.now()
        t, d = now.strftime("%H:%M"), now.strftime("%A, %d %B")
        for c, dt in self._clock_pairs:
            c.set_label(t)
            dt.set_label(d)
        return True

    def _status_text(self) -> str:
        parts = [self._layout_code or "?"]
        if self._caps:
            parts.append(_("caps"))
        return " · ".join(parts)

    def _refresh_status_labels(self) -> None:
        text = self._status_text()
        for lab in self._status_labels:
            lab.set_label(text)
            if self._caps:
                lab.add_css_class("status-caps")
                lab.remove_css_class("status-warn")
            elif (self._layout_code or "").upper() not in ("US", "EN", "?"):
                lab.add_css_class("status-warn")
                lab.remove_css_class("status-caps")
            else:
                lab.remove_css_class("status-warn")
                lab.remove_css_class("status-caps")

    def _poll_status(self) -> None:
        raw = _active_keymap_raw()
        if raw:
            self._layout_code = _short_layout(raw)
        self._caps = _caps_lock_on(self._caps)
        self._refresh_status_labels()

    def _poll_status_once(self):
        if not self._shutting_down:
            self._poll_status()
        return False

    def _tick_status(self):
        if self._shutting_down:
            return False
        self._poll_status()
        return True

    def _update_dots(self):
        dots = "●" * len(self._pw) if self._pw else " "
        for lab in self._dot_labels:
            lab.set_label(dots)

    def _wipe_password(self):
        _wipe_bytearray(self._pw)

    def _clear_password(self):
        self._wipe_password()
        self._update_dots()

    def _authenticate(self) -> bool:
        if pam is None:
            return False
        secret = self._pw.decode("utf-8", errors="surrogateescape")
        try:
            return bool(pam.pam().authenticate(self.user, secret))
        except Exception as e:
            log(f"pam error: {type(e).__name__}")
            return False
        finally:
            secret = "\0" * len(secret)
            del secret
            self._wipe_password()

    def _set_errors(self, text: str):
        for err in self._err_labels:
            err.set_label(text)

    def _try_unlock(self):
        now = time.monotonic()
        if now < self._unlock_blocked_until:
            left = int(self._unlock_blocked_until - now) + 1
            self._set_errors(_("wait", n=left))
            return

        if self._authenticate():
            self._fail_count = 0
            self.lock.unlock()
            return

        self._fail_count += 1
        delay = min(8.0, 0.5 * (2 ** min(self._fail_count - 1, 4)))
        self._unlock_blocked_until = time.monotonic() + delay
        self._set_errors(_("bad_password"))
        self._clear_password()
        GLib.timeout_add(int(delay * 1000), self._clear_backoff_message)

    def _clear_backoff_message(self):
        if time.monotonic() >= self._unlock_blocked_until:
            self._set_errors("")
        return False

    def _on_key(self, _ctrl, keyval: int, _keycode: int, state: Gdk.ModifierType) -> bool:
        # Track caps from modifiers; Caps_Lock toggles after this event → idle refresh
        self._caps = bool(state & Gdk.ModifierType.LOCK_MASK) or _caps_lock_on(
            bool(state & Gdk.ModifierType.LOCK_MASK)
        )
        if keyval == Gdk.KEY_Caps_Lock:
            GLib.timeout_add(50, self._poll_status_once)
            return True
        if keyval in (
            Gdk.KEY_Shift_L, Gdk.KEY_Shift_R, Gdk.KEY_Control_L, Gdk.KEY_Control_R,
            Gdk.KEY_Alt_L, Gdk.KEY_Alt_R, Gdk.KEY_Meta_L, Gdk.KEY_Meta_R,
            Gdk.KEY_Super_L, Gdk.KEY_Super_R, Gdk.KEY_Num_Lock,
        ):
            # Alt/Shift may switch XKB group — refresh layout shortly
            if keyval in (Gdk.KEY_Alt_L, Gdk.KEY_Alt_R, Gdk.KEY_Shift_L, Gdk.KEY_Shift_R):
                GLib.timeout_add(80, self._poll_status_once)
            return True
        if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            self._try_unlock()
            return True
        if keyval == Gdk.KEY_Escape:
            return True
        if time.monotonic() < self._unlock_blocked_until:
            self._refresh_status_labels()
            return True
        if keyval == Gdk.KEY_BackSpace:
            if self._pw:
                self._pw.pop()
                self._update_dots()
                self._set_errors("")
            return True
        if keyval == Gdk.KEY_u and (state & Gdk.ModifierType.CONTROL_MASK):
            self._clear_password()
            return True
        ch = Gdk.keyval_to_unicode(keyval)
        if ch and ch >= 32:
            if len(self._pw) < 256:
                self._pw.extend(chr(ch).encode("utf-8"))
            self._update_dots()
            self._set_errors("")
            # Typing often follows layout toggle — keep indicator fresh
            GLib.timeout_add(50, self._poll_status_once)
            return True
        self._refresh_status_labels()
        return True

    def _start_gst_video(self, stack: Gtk.Stack, video_page: Gtk.Widget):
        if not VIDEO.is_file():
            log("no video file")
            self._start_frame_fallback(stack, video_page)
            return
        try:
            v = Gtk.Video.new_for_filename(str(VIDEO))
            for setter, arg in (
                ("set_autoplay", True),
                ("set_loop", True),
                ("set_controls", False),
                ("set_muted", True),
            ):
                try:
                    getattr(v, setter)(arg)
                except Exception:
                    pass
            v.set_hexpand(True)
            v.set_vexpand(True)
            try:
                stack.remove(video_page)
            except Exception:
                pass
            stack.add_named(v, "video")
            stack.set_visible_child_name("video")
            self._media = v
            log("Gtk.Video started")
            try:
                mf = v.get_media_stream()
                if mf is not None:
                    mf.set_loop(True)
                    try:
                        mf.set_muted(True)
                    except Exception:
                        pass
                    mf.play()
            except Exception as e:
                log(f"stream poke: {type(e).__name__}")

            def watchdog():
                try:
                    mf = v.get_media_stream()
                    ok = mf is not None and mf.get_playing()
                except Exception:
                    ok = False
                if ok:
                    log("watchdog: Gtk.Video ok")
                    return False
                log("watchdog: fallback to frames")
                pic = Gtk.Picture()
                if hasattr(pic, "set_content_fit"):
                    pic.set_content_fit(Gtk.ContentFit.COVER)
                pic.set_hexpand(True)
                pic.set_vexpand(True)
                try:
                    stack.remove(v)
                except Exception:
                    pass
                stack.add_named(pic, "video")
                self._start_frame_fallback(stack, pic)
                return False

            GLib.timeout_add(1500, watchdog)
        except Exception as e:
            log(f"Gtk.Video fail: {type(e).__name__}")
            self._start_frame_fallback(stack, video_page)

    def _load_frame_textures(self):
        if self._frame_textures:
            return
        paths = sorted(FRAME_DIR.glob("f-*.jpg")) if FRAME_DIR.is_dir() else []
        safe: list[Path] = []
        try:
            root = FRAME_DIR.resolve()
        except Exception:
            root = FRAME_DIR
        for fp in paths:
            try:
                rp = fp.resolve()
                if root in rp.parents or rp.parent == root:
                    safe.append(fp)
            except Exception:
                continue
        paths = safe
        if len(paths) > 24:
            step = max(1, len(paths) // 24)
            paths = paths[::step][:24]
        for fp in paths:
            try:
                self._frame_textures.append(Gdk.Texture.new_from_filename(str(fp)))
            except Exception as e:
                log(f"tex skip: {type(e).__name__}")
        log(f"textures={len(self._frame_textures)}")

    def _start_frame_fallback(self, stack: Gtk.Stack, video_page: Gtk.Picture):
        if self._using_frames:
            return
        self._using_frames = True
        if self._media is not None:
            try:
                self._media.pause()
            except Exception:
                pass
            self._media = None
        self._load_frame_textures()
        if not self._frame_textures:
            log("no frames; keep poster/solid")
            return
        video_page.set_paintable(self._frame_textures[0])
        stack.set_visible_child_name("video")

        def tick():
            if not self._using_frames or not self._frame_textures:
                return False
            self._frame_i = (self._frame_i + 1) % len(self._frame_textures)
            tex = self._frame_textures[self._frame_i]
            for st in self._bg_stack:
                child = st.get_child_by_name("video")
                if child is not None:
                    try:
                        child.set_paintable(tex)
                    except Exception:
                        pass
            return True

        GLib.timeout_add(125, tick)
        log("frame animation running")

    def _on_monitor(self, _lock, monitor: Gdk.Monitor):
        try:
            try:
                mid = monitor.get_connector() or monitor.get_description() or "mon"
            except Exception:
                mid = "mon"
            if mid in self._monitors_done:
                return
            self._monitors_done.add(mid)
            log(f"monitor {mid}")

            win = Gtk.Window()
            win.set_decorated(False)
            win.set_can_focus(True)
            win.set_focusable(True)

            overlay = Gtk.Overlay()
            win.set_child(overlay)

            stack = Gtk.Stack()
            stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
            stack.set_transition_duration(200)
            stack.set_hexpand(True)
            stack.set_vexpand(True)

            poster = Gtk.Picture()
            if POSTER.is_file():
                poster.set_filename(str(POSTER))
            if hasattr(poster, "set_content_fit"):
                poster.set_content_fit(Gtk.ContentFit.COVER)
            poster.set_hexpand(True)
            poster.set_vexpand(True)

            video_page = Gtk.Picture()
            if hasattr(video_page, "set_content_fit"):
                video_page.set_content_fit(Gtk.ContentFit.COVER)
            video_page.set_hexpand(True)
            video_page.set_vexpand(True)

            stack.add_named(poster, "poster")
            stack.add_named(video_page, "video")
            stack.set_visible_child_name("poster")
            self._bg_stack.append(stack)

            dim = Gtk.Box()
            dim.add_css_class("dim")
            dim.set_hexpand(True)
            dim.set_vexpand(True)

            overlay.set_child(stack)
            overlay.add_overlay(dim)

            panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            panel.add_css_class("panel")
            panel.set_halign(Gtk.Align.CENTER)
            panel.set_valign(Gtk.Align.CENTER)

            clock = Gtk.Label(label=datetime.now().strftime("%H:%M"))
            clock.add_css_class("clock")
            date = Gtk.Label(label=datetime.now().strftime("%A, %d %B"))
            date.add_css_class("date")
            user = Gtk.Label(label=self.user)
            user.add_css_class("user")
            dots = Gtk.Label(label=" ")
            dots.add_css_class("dots")
            dots.set_xalign(0.0)
            err = Gtk.Label(label="")
            err.add_css_class("error")
            hint = Gtk.Label(label=_("hint"))
            hint.add_css_class("hint")
            status = Gtk.Label(label=self._status_text())
            status.add_css_class("status")

            for w in (clock, date, user, dots, err, hint, status):
                panel.append(w)
            overlay.add_overlay(panel)

            self._clock_pairs.append((clock, date))
            self._dot_labels.append(dots)
            self._err_labels.append(err)
            self._status_labels.append(status)
            self._windows.append(win)
            self._refresh_status_labels()

            key = Gtk.EventControllerKey()
            key.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
            key.connect("key-pressed", self._on_key)
            win.add_controller(key)

            self.lock.assign_window_to_monitor(win, monitor)
            win.present()
            log("surface ok")

            def _boot():
                if os.environ.get("VIDEOLOCK_GST", "0") == "1":
                    self._start_gst_video(stack, video_page)
                else:
                    self._start_frame_fallback(stack, video_page)
                return False

            GLib.idle_add(_boot)
        except Exception:
            log(traceback.format_exc())


def _parse_args(argv: list[str] | None) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        prog="videolock",
        description="Wayland session lock for Hyprland (GTK4 + PAM).",
    )
    p.add_argument("-V", "--version", action="version", version=f"videolock {__version__}")
    p.add_argument(
        "--check",
        action="store_true",
        help="verify dependencies and asset paths, then exit",
    )
    p.add_argument(
        "--recover",
        action="store_true",
        help="recover from crashed lock: stop hung locker + clear crash overlay",
    )
    return p.parse_args(argv)


def _check() -> int:
    ok = True
    scale = _ui_scale()
    print(f"videolock {__version__}")
    print(f"  cache:  {CACHE_DIR}")
    print(f"  data:   {DATA_DIR}")
    print(f"  scale:  {scale:.2f} (override VIDEOLOCK_SCALE)")
    print(f"  poster: {POSTER}  [{'ok' if POSTER.is_file() else 'missing'}]")
    print(f"  video:  {VIDEO}  [{'ok' if VIDEO.is_file() else 'missing'}]")
    nframes = len(list(FRAME_DIR.glob('f-*.jpg'))) if FRAME_DIR.is_dir() else 0
    print(f"  frames: {FRAME_DIR}  [{nframes} jpg]")
    if pam is None:
        print("  pam:    MISSING (python-pam / python3-pam)")
        ok = False
    else:
        print("  pam:    ok")
    if not SessionLock.is_supported():
        print("  lock:   ext-session-lock-v1 NOT supported on this compositor")
        ok = False
    else:
        print("  lock:   supported")
    return 0 if ok else 1


def main(argv: list[str] | None = None) -> int:
    args = _parse_args(argv)
    if args.recover:
        return _recover_session()
    if args.check:
        return _check()

    if not _acquire_singleton():
        log("already running — exit")
        return 0

    try:
        fd = os.open(str(LOG), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(f"start {datetime.now().isoformat()} v{__version__}\n")
    except Exception:
        pass

    app = Gtk.Application(
        application_id="org.videolock.VideoLock",
        flags=Gio.ApplicationFlags.NON_UNIQUE,
    )

    def on_activate(app: Gtk.Application):
        app.hold()
        scale = _ui_scale()
        log(f"ui scale={scale:.2f}")
        css = Gtk.CssProvider()
        css.load_from_data(_build_css(scale))
        display = Gdk.Display.get_default()
        Gtk.StyleContext.add_provider_for_display(
            display, css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        app._videolock = VideoLock(app)  # noqa: SLF001 — keep GC ref
        app._videolock.start()

    app.connect("activate", on_activate)
    return app.run([]) or 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception:
        log(traceback.format_exc())
        raise
